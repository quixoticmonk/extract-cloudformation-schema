{
    "typeName": "AWS::Comprehend::EntitiesDetectionJob",
    "description": "An Amazon Comprehend entities detection job that identifies entities in a collection of documents.",
    "properties": {
        "JobArn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the entities detection job.",
            "maxLength": 256,
            "pattern": "^arn:aws(-[^:]+)?:comprehend:[a-zA-Z0-9-]*:[0-9]{12}:[a-zA-Z0-9-]{1,64}/[a-zA-Z0-9](-*[a-zA-Z0-9])*(/version/[a-zA-Z0-9](-*[a-zA-Z0-9])*)?$"
        },
        "JobId": {
            "type": "string",
            "description": "The identifier assigned to the entities detection job.",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-%@]*)$"
        },
        "JobName": {
            "type": "string",
            "description": "The name that you assigned the entities detection job.",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-%@]*)$"
        },
        "JobStatus": {
            "type": "string",
            "description": "The current status of the entities detection job.",
            "enum": ["SUBMITTED", "IN_PROGRESS", "COMPLETED", "FAILED", "STOP_REQUESTED", "STOPPED"]
        },
        "InputDataConfig": {
            "description": "Specifies the format and location of the input data for the job.",
            "$ref": "#/definitions/InputDataConfig"
        },
        "OutputDataConfig": {
            "description": "Specifies where to send the output files.",
            "$ref": "#/definitions/OutputDataConfig"
        },
        "DataAccessRoleArn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the IAM role that grants Amazon Comprehend read access to your input data.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws(-[^:]+)?:iam::[0-9]{12}:role/.+$"
        },
        "LanguageCode": {
            "type": "string",
            "description": "The language of the input documents.",
            "enum": ["en", "es", "fr", "de", "it", "pt", "ar", "hi", "ja", "ko", "zh", "zh-TW"]
        },
        "SubmitTime": {
            "type": "string",
            "format": "date-time",
            "description": "The time that the entities detection job was submitted for processing."
        },
        "Tags": {
            "type": "array",
            "description": "Tags associated with the entities detection job.",
            "items": {
                "$ref": "#/definitions/Tag"
            }
        }
    },
    "definitions": {
        "InputDataConfig": {
            "type": "object",
            "properties": {
                "S3Uri": {
                    "type": "string",
                    "description": "The Amazon S3 URI for the input data.",
                    "maxLength": 1024,
                    "pattern": "^s3://[a-z0-9][\\.\\-a-z0-9]{1,61}[a-z0-9](/.*)?$"
                },
                "InputFormat": {
                    "type": "string",
                    "description": "Specifies how the text in an input file should be processed.",
                    "enum": ["ONE_DOC_PER_FILE", "ONE_DOC_PER_LINE"]
                }
            },
            "required": ["S3Uri"],
            "additionalProperties": false
        },
        "OutputDataConfig": {
            "type": "object",
            "properties": {
                "S3Uri": {
                    "type": "string",
                    "description": "When you use the OutputDataConfig object with asynchronous operations, you specify the Amazon S3 location where you want to write the output data.",
                    "maxLength": 1024,
                    "pattern": "^s3://[a-z0-9][\\.\\-a-z0-9]{1,61}[a-z0-9](/.*)?$"
                }
            },
            "required": ["S3Uri"],
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key of the tag.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The value of the tag.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        }
    },
    "required": ["InputDataConfig", "DataAccessRoleArn", "LanguageCode"],
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/DataAccessRoleArn",
        "/properties/InputDataConfig",
        "/properties/JobName",
        "/properties/LanguageCode",
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/JobArn",
        "/properties/JobId",
        "/properties/JobStatus",
        "/properties/SubmitTime",
        "/properties/OutputDataConfig"
    ],
    "primaryIdentifier": ["/properties/JobArn"],
    "additionalIdentifiers": [["/properties/JobId"]],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": ["comprehend:ListTagsForResource"]
    },
    "handlers": {
        "read": {
            "permissions": [
                "comprehend:DescribeEntitiesDetectionJob",
                "comprehend:ListTagsForResource"
            ]
        },
        "list": {
            "permissions": [
                "comprehend:ListEntitiesDetectionJobs"
            ]
        }
    }
}
