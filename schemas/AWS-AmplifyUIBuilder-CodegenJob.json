{
    "typeName": "AWS::AmplifyUIBuilder::CodegenJob",
    "description": "Represents an Amplify UI Builder code generation job resource. This is a read-only resource that provides visibility into code generation jobs started via the Amplify UI Builder API.",
    "definitions": {
        "CodegenFeatureFlags": {
            "type": "object",
            "description": "Describes the feature flags for a code generation job.",
            "properties": {
                "IsRelationshipSupported": {
                    "type": "boolean",
                    "description": "Specifies whether a code generation job supports data relationships."
                },
                "IsNonModelSupported": {
                    "type": "boolean",
                    "description": "Specifies whether a code generation job supports non models."
                }
            },
            "additionalProperties": false
        },
        "GraphQLRenderConfig": {
            "type": "object",
            "description": "Describes the GraphQL configuration for an API for a code generation job.",
            "properties": {
                "TypesFilePath": {
                    "type": "string",
                    "description": "The path to the GraphQL types file, relative to the component output directory."
                },
                "QueriesFilePath": {
                    "type": "string",
                    "description": "The path to the GraphQL queries file, relative to the component output directory."
                },
                "MutationsFilePath": {
                    "type": "string",
                    "description": "The path to the GraphQL mutations file, relative to the component output directory."
                },
                "SubscriptionsFilePath": {
                    "type": "string",
                    "description": "The path to the GraphQL subscriptions file, relative to the component output directory."
                },
                "FragmentsFilePath": {
                    "type": "string",
                    "description": "The path to the GraphQL fragments file, relative to the component output directory."
                }
            },
            "required": ["TypesFilePath", "QueriesFilePath", "MutationsFilePath", "SubscriptionsFilePath", "FragmentsFilePath"],
            "additionalProperties": false
        },
        "DataStoreRenderConfig": {
            "type": "object",
            "description": "Describes the DataStore configuration for an API for a code generation job.",
            "additionalProperties": false
        },
        "NoApiRenderConfig": {
            "type": "object",
            "description": "Describes the configuration for an application with no API being used.",
            "additionalProperties": false
        },
        "ApiConfiguration": {
            "type": "object",
            "description": "Describes the API configuration for a code generation job.",
            "properties": {
                "GraphQLConfig": {
                    "$ref": "#/definitions/GraphQLRenderConfig"
                },
                "DataStoreConfig": {
                    "$ref": "#/definitions/DataStoreRenderConfig"
                },
                "NoApiConfig": {
                    "$ref": "#/definitions/NoApiRenderConfig"
                }
            },
            "additionalProperties": false
        },
        "ReactStartCodegenJobData": {
            "type": "object",
            "description": "Describes the code generation job configuration for a React project.",
            "properties": {
                "Module": {
                    "type": "string",
                    "description": "The JavaScript module type.",
                    "enum": ["es2020", "esnext"]
                },
                "Target": {
                    "type": "string",
                    "description": "The ECMAScript specification to use.",
                    "enum": ["es2015", "es2020"]
                },
                "Script": {
                    "type": "string",
                    "description": "The file type to use for a JavaScript project.",
                    "enum": ["jsx", "tsx", "js"]
                },
                "RenderTypeDeclarations": {
                    "type": "boolean",
                    "description": "Specifies whether the code generation job should render type declaration files."
                },
                "InlineSourceMap": {
                    "type": "boolean",
                    "description": "Specifies whether the code generation job should render inline source maps."
                },
                "ApiConfiguration": {
                    "$ref": "#/definitions/ApiConfiguration"
                }
            },
            "additionalProperties": false
        },
        "CodegenJobRenderConfig": {
            "type": "object",
            "description": "Describes the configuration information for rendering the UI component associated with the code generation job. This is a union type with a single member.",
            "properties": {
                "React": {
                    "$ref": "#/definitions/ReactStartCodegenJobData"
                }
            },
            "required": ["React"],
            "additionalProperties": false
        },
        "CodegenGenericDataRelationshipType": {
            "type": "object",
            "description": "Describes the relationship between generic data models.",
            "properties": {
                "Type": {
                    "type": "string",
                    "description": "The data relationship type.",
                    "enum": ["HAS_MANY", "HAS_ONE", "BELONGS_TO"]
                },
                "RelatedModelName": {
                    "type": "string",
                    "description": "The name of the related model in the data relationship."
                },
                "RelatedModelFields": {
                    "type": "array",
                    "description": "The related model fields in the data relationship.",
                    "insertionOrder": false,
                    "items": {
                        "type": "string"
                    }
                },
                "CanUnlinkAssociatedModel": {
                    "type": "boolean",
                    "description": "Specifies whether the relationship can unlink the associated model."
                },
                "RelatedJoinFieldName": {
                    "type": "string",
                    "description": "The name of the related join field in the data relationship."
                },
                "RelatedJoinTableName": {
                    "type": "string",
                    "description": "The name of the related join table in the data relationship."
                },
                "BelongsToFieldOnRelatedModel": {
                    "type": "string",
                    "description": "The value of the belongsTo field on the related data model."
                },
                "AssociatedFields": {
                    "type": "array",
                    "description": "The associated fields of the data relationship.",
                    "insertionOrder": false,
                    "items": {
                        "type": "string"
                    }
                },
                "IsHasManyIndex": {
                    "type": "boolean",
                    "description": "Specifies whether the @index directive is supported for a hasMany data relationship."
                }
            },
            "required": ["Type", "RelatedModelName"],
            "additionalProperties": false
        },
        "CodegenGenericDataField": {
            "type": "object",
            "description": "Describes a field in a generic data schema.",
            "properties": {
                "DataType": {
                    "type": "string",
                    "description": "The data type for the generic data field.",
                    "enum": ["ID", "String", "Int", "Float", "AWSDate", "AWSTime", "AWSDateTime", "AWSTimestamp", "AWSEmail", "AWSURL", "AWSIPAddress", "Boolean", "AWSJSON", "AWSPhone", "Enum", "Model", "NonModel"]
                },
                "DataTypeValue": {
                    "type": "string",
                    "description": "The value of the data type for the generic data field."
                },
                "Required": {
                    "type": "boolean",
                    "description": "Specifies whether the generic data field is required."
                },
                "ReadOnly": {
                    "type": "boolean",
                    "description": "Specifies whether the generic data field is read-only."
                },
                "IsArray": {
                    "type": "boolean",
                    "description": "Specifies whether the generic data field is an array."
                },
                "Relationship": {
                    "$ref": "#/definitions/CodegenGenericDataRelationshipType"
                }
            },
            "required": ["DataType", "DataTypeValue", "Required", "ReadOnly", "IsArray"],
            "additionalProperties": false
        },
        "CodegenGenericDataModel": {
            "type": "object",
            "description": "Describes a model in a generic data schema.",
            "properties": {
                "Fields": {
                    "type": "object",
                    "description": "The fields in the generic data model.",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/CodegenGenericDataField"
                        }
                    },
                    "additionalProperties": false
                },
                "IsJoinTable": {
                    "type": "boolean",
                    "description": "Specifies whether the generic data model is a join table."
                },
                "PrimaryKeys": {
                    "type": "array",
                    "description": "The primary keys of the generic data model.",
                    "insertionOrder": false,
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": ["Fields", "PrimaryKeys"],
            "additionalProperties": false
        },
        "CodegenGenericDataEnum": {
            "type": "object",
            "description": "Describes the enums in a generic data schema.",
            "properties": {
                "Values": {
                    "type": "array",
                    "description": "The list of enum values in the generic data schema.",
                    "insertionOrder": false,
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": ["Values"],
            "additionalProperties": false
        },
        "CodegenGenericDataNonModel": {
            "type": "object",
            "description": "Describes a non-model in a generic data schema.",
            "properties": {
                "Fields": {
                    "type": "object",
                    "description": "The fields in a generic data schema non model.",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/CodegenGenericDataField"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": ["Fields"],
            "additionalProperties": false
        },
        "CodegenJobGenericDataSchema": {
            "type": "object",
            "description": "Describes the data schema for a code generation job.",
            "properties": {
                "DataSourceType": {
                    "type": "string",
                    "description": "The type of the data source for the schema.",
                    "enum": ["DataStore"]
                },
                "Models": {
                    "type": "object",
                    "description": "The name of a CodegenGenericDataModel.",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/CodegenGenericDataModel"
                        }
                    },
                    "additionalProperties": false
                },
                "Enums": {
                    "type": "object",
                    "description": "The name of a CodegenGenericDataEnum.",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/CodegenGenericDataEnum"
                        }
                    },
                    "additionalProperties": false
                },
                "NonModels": {
                    "type": "object",
                    "description": "The name of a CodegenGenericDataNonModel.",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/CodegenGenericDataNonModel"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": ["DataSourceType", "Models", "Enums", "NonModels"],
            "additionalProperties": false
        },
        "CodegenDependency": {
            "type": "object",
            "description": "Dependency package that may be required for the project code to run.",
            "properties": {
                "Name": {
                    "type": "string",
                    "description": "Name of the dependency package."
                },
                "SupportedVersion": {
                    "type": "string",
                    "description": "Indicates the version of the supported dependency package."
                },
                "IsSemVer": {
                    "type": "boolean",
                    "description": "Determines if the dependency package is using Semantic versioning."
                },
                "Reason": {
                    "type": "string",
                    "description": "Indicates the reason to include the dependency package in your project code."
                }
            },
            "additionalProperties": false
        },
        "CodegenJobAsset": {
            "type": "object",
            "description": "Describes an asset for a code generation job.",
            "properties": {
                "DownloadUrl": {
                    "type": "string",
                    "description": "The URL to use to access the asset."
                }
            },
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "description": "A key-value pair that is used to tag the code generation job.",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key of the tag.",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^(?!aws:)[a-zA-Z+-=._:/]+$"
                },
                "Value": {
                    "type": "string",
                    "description": "The value of the tag.",
                    "minLength": 1,
                    "maxLength": 256
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        }
    },
    "properties": {
        "Arn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the code generation job."
        },
        "AppId": {
            "type": "string",
            "description": "The unique ID for the Amplify app.",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^d[a-z0-9]+$"
        },
        "EnvironmentName": {
            "type": "string",
            "description": "The name of the backend environment that is a part of the Amplify app."
        },
        "Id": {
            "type": "string",
            "description": "The unique ID for the code generation job."
        },
        "RenderConfig": {
            "$ref": "#/definitions/CodegenJobRenderConfig"
        },
        "AutoGenerateForms": {
            "type": "boolean",
            "description": "Specifies whether to autogenerate forms in the code generation job."
        },
        "Features": {
            "$ref": "#/definitions/CodegenFeatureFlags"
        },
        "Status": {
            "type": "string",
            "description": "The status of the code generation job.",
            "enum": ["in_progress", "failed", "succeeded"]
        },
        "Tags": {
            "type": "array",
            "description": "One or more key-value pairs that are assigned to the code generation job.",
            "insertionOrder": false,
            "items": {
                "$ref": "#/definitions/Tag"
            }
        }
    },
    "required": ["RenderConfig"],
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/AppId",
        "/properties/AutoGenerateForms",
        "/properties/EnvironmentName",
        "/properties/Features",
        "/properties/RenderConfig"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/Id",
        "/properties/Status",
        "/properties/Tags"
    ],
    "primaryIdentifier": ["/properties/Arn"],
    "additionalIdentifiers": [["/properties/AppId", "/properties/EnvironmentName", "/properties/Id"]],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "amplifyuibuilder:GetCodegenJob"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "amplifyuibuilder:GetCodegenJob",
                "amplify:GetApp"
            ]
        },
        "list": {
            "handlerSchema": {
                "properties": {
                    "AppId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20,
                        "pattern": "^d[a-z0-9]+$"
                    },
                    "EnvironmentName": {
                        "type": "string"
                    }
                },
                "required": ["AppId", "EnvironmentName"]
            },
            "permissions": [
                "amplifyuibuilder:ListCodegenJobs",
                "amplify:GetApp"
            ]
        }
    }
}
