{
    "typeName": "AWS::DeviceFarm::RemoteAccessSession",
    "description": "Resource Type definition for AWS::DeviceFarm::RemoteAccessSession. Represents an interactive remote access session with a physical device in AWS Device Farm. A remote access session is an ephemeral, job-like resource, so this is a read-only resource type that provides information about a session created through the Device Farm API or console.",
    "definitions": {
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The tag key.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The tag value.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": [
                "Key",
                "Value"
            ],
            "additionalProperties": false
        },
        "DeviceProxy": {
            "type": "object",
            "description": "Represents the http/https proxy configuration applied to the device during the remote access session.",
            "properties": {
                "Host": {
                    "type": "string",
                    "description": "The host name or IP address of the http/https proxy.",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^([a-zA-Z0-9])([a-zA-Z0-9-.]+)([a-zA-Z0-9])$"
                },
                "Port": {
                    "type": "integer",
                    "description": "The port number on which the http/https proxy is listening.",
                    "minimum": 1,
                    "maximum": 65535
                }
            },
            "required": [
                "Host",
                "Port"
            ],
            "additionalProperties": false
        },
        "DeviceMinutes": {
            "type": "object",
            "description": "Represents the total device minutes used by the remote access session.",
            "properties": {
                "Total": {
                    "type": "number",
                    "description": "The total number of device minutes used by the remote access session."
                },
                "Metered": {
                    "type": "number",
                    "description": "The sum of metered device minutes used by the remote access session."
                },
                "Unmetered": {
                    "type": "number",
                    "description": "The sum of unmetered device minutes used by the remote access session."
                }
            },
            "additionalProperties": false
        },
        "VpcConfig": {
            "type": "object",
            "description": "The VPC security groups, subnets and VPC that are attached to the remote access session, inherited from the project. Applies only to private device instances.",
            "properties": {
                "SecurityGroupIds": {
                    "type": "array",
                    "description": "The security group IDs attached to the session.",
                    "insertionOrder": false,
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^sg-[0-9a-fA-F]{8,}$"
                    }
                },
                "SubnetIds": {
                    "type": "array",
                    "description": "The subnet IDs attached to the session.",
                    "insertionOrder": false,
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^subnet-[0-9a-fA-F]{8,}$"
                    }
                },
                "VpcId": {
                    "type": "string",
                    "description": "The ID of the VPC attached to the session.",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                }
            },
            "required": [
                "SecurityGroupIds",
                "SubnetIds",
                "VpcId"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "Arn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the remote access session.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "ProjectArn": {
            "type": "string",
            "description": "The ARN of the project that contains the remote access session.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "DeviceArn": {
            "type": "string",
            "description": "The ARN of the device being remotely accessed by the session.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "AppUpload": {
            "type": "string",
            "description": "The ARN of the app uploaded to Device Farm and installed on the device for the remote access session.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "Name": {
            "type": "string",
            "description": "The name of the remote access session.",
            "maxLength": 256
        },
        "BillingMethod": {
            "type": "string",
            "description": "The billing method of the remote access session.",
            "enum": [
                "METERED",
                "UNMETERED"
            ]
        },
        "SkipAppResign": {
            "type": "boolean",
            "description": "When set to true, for private devices, Device Farm does not sign your app again."
        },
        "DeviceProxy": {
            "$ref": "#/definitions/DeviceProxy"
        },
        "InstanceArn": {
            "type": "string",
            "description": "The ARN of the private device instance the remote access session runs on. Applies only to private device instances.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "Status": {
            "type": "string",
            "description": "The status of the remote access session.",
            "enum": [
                "PENDING",
                "PENDING_CONCURRENCY",
                "PENDING_DEVICE",
                "PROCESSING",
                "SCHEDULING",
                "PREPARING",
                "RUNNING",
                "COMPLETED",
                "STOPPING"
            ]
        },
        "Result": {
            "type": "string",
            "description": "The result of the remote access session.",
            "enum": [
                "PENDING",
                "PASSED",
                "WARNED",
                "FAILED",
                "SKIPPED",
                "ERRORED",
                "STOPPED"
            ]
        },
        "Message": {
            "type": "string",
            "description": "A message about the remote access session.",
            "maxLength": 16384
        },
        "Created": {
            "type": "string",
            "description": "The date and time the remote access session was created.",
            "format": "date-time"
        },
        "DeviceMinutes": {
            "$ref": "#/definitions/DeviceMinutes"
        },
        "VpcConfig": {
            "$ref": "#/definitions/VpcConfig"
        },
        "Tags": {
            "type": "array",
            "description": "The tags assigned to the remote access session.",
            "insertionOrder": false,
            "items": {
                "$ref": "#/definitions/Tag"
            }
        }
    },
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/ProjectArn",
        "/properties/DeviceArn",
        "/properties/AppUpload",
        "/properties/Name",
        "/properties/BillingMethod",
        "/properties/SkipAppResign",
        "/properties/DeviceProxy",
        "/properties/InstanceArn",
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/Status",
        "/properties/Result",
        "/properties/Message",
        "/properties/Created",
        "/properties/DeviceMinutes",
        "/properties/VpcConfig"
    ],
    "primaryIdentifier": [
        "/properties/Arn"
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "devicefarm:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "devicefarm:GetRemoteAccessSession",
                "devicefarm:ListTagsForResource"
            ]
        },
        "list": {
            "handlerSchema": {
                "properties": {
                    "ProjectArn": {
                        "type": "string",
                        "description": "The ARN of the project whose remote access sessions are listed.",
                        "minLength": 32,
                        "maxLength": 1011,
                        "pattern": "^arn:aws:devicefarm:.+$"
                    }
                },
                "required": [
                    "ProjectArn"
                ]
            },
            "permissions": [
                "devicefarm:ListRemoteAccessSessions"
            ]
        }
    }
}
