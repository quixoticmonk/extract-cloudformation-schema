{
    "typeName": "AWS::CleanRoomsML::TrainedModel",
    "description": "Represents a trained model in AWS Clean Rooms ML. A trained model is created by running a training job on a configured model algorithm association within a membership.",
    "definitions": {
        "ModelTrainingDataChannel": {
            "type": "object",
            "properties": {
                "ChannelName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-zA-Z0-9_.-]+$"
                },
                "MlInputChannelArn": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2048,
                    "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ml-input-channel/[-a-zA-Z0-9_/.]+$"
                },
                "S3DataDistributionType": {
                    "type": "string",
                    "enum": [
                        "FullyReplicated",
                        "ShardedByS3Key"
                    ]
                }
            },
            "required": [
                "ChannelName",
                "MlInputChannelArn"
            ],
            "additionalProperties": false
        },
        "ResourceConfig": {
            "type": "object",
            "properties": {
                "InstanceCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                },
                "InstanceType": {
                    "type": "string"
                },
                "VolumeSizeInGB": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                }
            },
            "required": [
                "InstanceType",
                "VolumeSizeInGB"
            ],
            "additionalProperties": false
        },
        "StoppingCondition": {
            "type": "object",
            "properties": {
                "MaxRuntimeInSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2419200
                }
            },
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": [
                "Key",
                "Value"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "TrainedModelArn": {
            "type": "string",
            "description": "The ARN of the trained model.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/trained-model/[-a-zA-Z0-9_/.]+$"
        },
        "TrainedModelId": {
            "type": "string",
            "description": "The unique identifier of the trained model."
        },
        "MembershipIdentifier": {
            "type": "string",
            "description": "The membership ID of the trained model.",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "CollaborationIdentifier": {
            "type": "string",
            "description": "The collaboration ID of the trained model.",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "Name": {
            "type": "string",
            "description": "The name of the trained model.",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^(?!\\s*$)[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t]*$"
        },
        "Description": {
            "type": "string",
            "description": "The description of the trained model.",
            "minLength": 0,
            "maxLength": 255,
            "pattern": "^[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t\\r\\n]*$"
        },
        "ConfiguredModelAlgorithmAssociationArn": {
            "type": "string",
            "description": "The ARN of the configured model algorithm association.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/configured-model-algorithm-association/[-a-zA-Z0-9_/.]+$"
        },
        "DataChannels": {
            "type": "array",
            "description": "The data channels for the trained model.",
            "items": {
                "$ref": "#/definitions/ModelTrainingDataChannel"
            },
            "minItems": 1,
            "maxItems": 20
        },
        "ResourceConfig": {
            "$ref": "#/definitions/ResourceConfig"
        },
        "Environment": {
            "type": "object",
            "description": "The environment variables for the trained model.",
            "patternProperties": {
                "^.+$": {
                    "type": "string",
                    "maxLength": 512
                }
            },
            "maxProperties": 100,
            "additionalProperties": false
        },
        "Hyperparameters": {
            "type": "object",
            "description": "The hyperparameters for the trained model.",
            "patternProperties": {
                "^.+$": {
                    "type": "string",
                    "maxLength": 2500
                }
            },
            "maxProperties": 100,
            "additionalProperties": false
        },
        "StoppingCondition": {
            "$ref": "#/definitions/StoppingCondition"
        },
        "TrainingInputMode": {
            "type": "string",
            "description": "The training input mode.",
            "enum": [
                "File",
                "FastFile",
                "Pipe"
            ]
        },
        "Status": {
            "type": "string",
            "description": "The status of the trained model.",
            "enum": [
                "CREATE_PENDING",
                "CREATE_IN_PROGRESS",
                "CREATE_FAILED",
                "ACTIVE",
                "DELETE_PENDING",
                "DELETE_IN_PROGRESS",
                "DELETE_FAILED",
                "INACTIVE",
                "CANCEL_PENDING",
                "CANCEL_IN_PROGRESS",
                "CANCEL_FAILED"
            ]
        },
        "KmsKeyArn": {
            "type": "string",
            "description": "The KMS key ARN used for encryption.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:kms:[-a-z0-9]+:[0-9]{12}:key/.+$"
        },
        "TrainingContainerImageDigest": {
            "type": "string",
            "description": "The digest of the training container image."
        },
        "CreateTime": {
            "type": "string",
            "description": "The time at which the trained model was created.",
            "format": "date-time"
        },
        "UpdateTime": {
            "type": "string",
            "description": "The time at which the trained model was last updated.",
            "format": "date-time"
        },
        "Tags": {
            "type": "array",
            "description": "An array of key-value pairs to apply to this resource.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "maxItems": 200,
            "insertionOrder": false
        }
    },
    "createOnlyProperties": [
        "/properties/MembershipIdentifier"
    ],
    "readOnlyProperties": [
        "/properties/TrainedModelArn",
        "/properties/TrainedModelId",
        "/properties/CollaborationIdentifier",
        "/properties/Name",
        "/properties/Description",
        "/properties/Status",
        "/properties/ConfiguredModelAlgorithmAssociationArn",
        "/properties/ResourceConfig",
        "/properties/DataChannels",
        "/properties/Environment",
        "/properties/Hyperparameters",
        "/properties/StoppingCondition",
        "/properties/TrainingInputMode",
        "/properties/KmsKeyArn",
        "/properties/TrainingContainerImageDigest",
        "/properties/CreateTime",
        "/properties/UpdateTime",
        "/properties/Tags"
    ],
    "primaryIdentifier": [
        "/properties/TrainedModelArn"
    ],
    "additionalProperties": false,
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "cleanrooms-ml:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "cleanrooms-ml:GetTrainedModel",
                "cleanrooms-ml:ListTagsForResource",
                "cleanrooms:GetMembership",
                "cleanrooms:PassMembership"
            ]
        },
        "list": {
            "permissions": [
                "cleanrooms-ml:ListTrainedModels",
                "cleanrooms:GetMembership",
                "cleanrooms:PassMembership"
            ],
            "handlerSchema": {
                "properties": {
                    "MembershipIdentifier": {
                        "type": "string",
                        "minLength": 36,
                        "maxLength": 36,
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                },
                "required": [
                    "MembershipIdentifier"
                ]
            }
        }
    },
    "additionalIdentifiers": [
        [
            "/properties/MembershipIdentifier",
            "/properties/TrainedModelId"
        ]
    ]
}
