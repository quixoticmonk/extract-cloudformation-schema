{
    "typeName": "AWS::CleanRoomsML::TrainedModelInferenceJob",
    "description": "Represents a trained model inference job in AWS Clean Rooms ML.",
    "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
    "definitions": {
        "InferenceResourceConfig": {
            "type": "object",
            "properties": {
                "InstanceType": {
                    "type": "string"
                },
                "InstanceCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                }
            },
            "required": [
                "InstanceType"
            ],
            "additionalProperties": false
        },
        "InferenceOutputConfiguration": {
            "type": "object",
            "properties": {
                "Accept": {
                    "type": "string",
                    "maxLength": 256
                },
                "Members": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/InferenceReceiverMember"
                    },
                    "minItems": 1,
                    "maxItems": 1
                }
            },
            "required": [
                "Members"
            ],
            "additionalProperties": false
        },
        "InferenceReceiverMember": {
            "type": "object",
            "properties": {
                "AccountId": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 12,
                    "pattern": "^[0-9]{12}$"
                }
            },
            "required": [
                "AccountId"
            ],
            "additionalProperties": false
        },
        "ModelInferenceDataSource": {
            "type": "object",
            "properties": {
                "MlInputChannelArn": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2048,
                    "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ml-input-channel/[-a-zA-Z0-9_/.]+$"
                }
            },
            "required": [
                "MlInputChannelArn"
            ],
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": [
                "Key",
                "Value"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "TrainedModelInferenceJobArn": {
            "type": "string",
            "description": "The ARN of the trained model inference job.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/trained-model-inference-job/[-a-zA-Z0-9_/.]+$"
        },
        "MembershipIdentifier": {
            "type": "string",
            "description": "The membership ID that contains the trained model inference job.",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "Name": {
            "type": "string",
            "description": "The name of the trained model inference job.",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^(?!\\s*$)[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t]*$"
        },
        "TrainedModelArn": {
            "type": "string",
            "description": "The ARN of the trained model used for this inference job.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/trained-model/[-a-zA-Z0-9_/.]+$"
        },
        "ConfiguredModelAlgorithmAssociationArn": {
            "type": "string",
            "description": "The ARN of the configured model algorithm association used for this job.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:membership/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/configured-model-algorithm-association/[-a-zA-Z0-9_/.]+$"
        },
        "ResourceConfig": {
            "$ref": "#/definitions/InferenceResourceConfig",
            "description": "The resource configuration for the inference job."
        },
        "OutputConfiguration": {
            "$ref": "#/definitions/InferenceOutputConfiguration",
            "description": "The output configuration for the inference job."
        },
        "DataSource": {
            "$ref": "#/definitions/ModelInferenceDataSource",
            "description": "The data source used for the inference job."
        },
        "Description": {
            "type": "string",
            "description": "The description of the trained model inference job.",
            "maxLength": 255,
            "pattern": "^[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t\\r\\n]*$"
        },
        "Status": {
            "type": "string",
            "description": "The status of the trained model inference job.",
            "enum": [
                "CREATE_PENDING",
                "CREATE_IN_PROGRESS",
                "CREATE_FAILED",
                "ACTIVE",
                "CANCEL_PENDING",
                "CANCEL_IN_PROGRESS",
                "CANCEL_FAILED",
                "INACTIVE"
            ]
        },
        "CreateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The time at which the trained model inference job was created."
        },
        "UpdateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The most recent time at which the trained model inference job was updated."
        },
        "Tags": {
            "type": "array",
            "description": "Tags associated with the trained model inference job.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "insertionOrder": false
        }
    },
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/MembershipIdentifier",
        "/properties/Name",
        "/properties/TrainedModelArn",
        "/properties/ResourceConfig",
        "/properties/OutputConfiguration",
        "/properties/DataSource",
        "/properties/Description",
        "/properties/ConfiguredModelAlgorithmAssociationArn",
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/TrainedModelInferenceJobArn",
        "/properties/Status",
        "/properties/CreateTime",
        "/properties/UpdateTime"
    ],
    "primaryIdentifier": [
        "/properties/TrainedModelInferenceJobArn"
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "cleanrooms-ml:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "cleanrooms-ml:GetTrainedModelInferenceJob",
                "cleanrooms-ml:ListTagsForResource",
                "cleanrooms:GetMembership",
                "cleanrooms:PassMembership"
            ]
        },
        "list": {
            "permissions": [
                "cleanrooms-ml:ListTrainedModelInferenceJobs",
                "cleanrooms:GetMembership",
                "cleanrooms:PassMembership"
            ],
            "handlerSchema": {
                "properties": {
                    "MembershipIdentifier": {
                        "type": "string",
                        "description": "The membership ID to list inference jobs for."
                    }
                },
                "required": [
                    "MembershipIdentifier"
                ]
            }
        }
    }
}