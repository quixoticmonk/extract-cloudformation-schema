            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:kms:[-a-z0-9]+:[0-9]{12}:key/.+$"
        },
        "TrainingDataStartTime": {
            "type": "string",
            "description": "The start date and time of the training window.",
            "format": "date-time"
        },
        "TrainingDataEndTime": {
            "type": "string",
            "description": "The end date and time of the training window.",
            "format": "date-time"
        },
        "Status": {
            "type": "string",
            "description": "The status of the audience model.",
            "enum": [
                "CREATE_PENDING",
                "CREATE_IN_PROGRESS",
                "CREATE_FAILED",
                "ACTIVE",
                "DELETE_PENDING",
                "DELETE_IN_PROGRESS",
                "DELETE_FAILED"
            ]
        },
        "CreateTime": {
            "type": "string",
            "description": "The time at which the audience model was created.",
            "format": "date-time"
        },
        "UpdateTime": {
            "type": "string",
            "description": "The most recent time at which the audience model was updated.",
            "format": "date-time"
        },
        "Tags": {
            "type": "array",
            "description": "The tags that are assigned to the audience model.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "insertionOrder": false,
            "maxItems": 200
        }
    },
    "definitions": {
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key of the tag.",
