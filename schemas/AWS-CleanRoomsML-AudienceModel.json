{
    "typeName": "AWS::CleanRoomsML::AudienceModel",
    "description": "Resource Type definition for AWS::CleanRoomsML::AudienceModel",
    "properties": {
        "AudienceModelArn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the audience model.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:audience-model/[-a-zA-Z0-9_/.]+$"
        },
        "Name": {
            "type": "string",
            "description": "The name of the audience model resource.",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^(?!\\s*$)[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t]*$"
        },
        "TrainingDatasetArn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the training dataset for this audience model.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:aws[-a-z]*:cleanrooms-ml:[-a-z0-9]+:[0-9]{12}:training-dataset/[-a-zA-Z0-9_/.]+$"
        },
        "Description": {
            "type": "string",
            "description": "The description of the audience model.",
            "minLength": 0,
            "maxLength": 255,
            "pattern": "^[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\t\\r\\n]*$"
        },
        "KmsKeyArn": {
            "type": "string",
