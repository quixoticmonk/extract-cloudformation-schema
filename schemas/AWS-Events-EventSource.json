{
    "typeName": "AWS::Events::EventSource",
    "description": "Resource type definition for AWS::Events::EventSource. Represents the consumer-side view of a partner event source in Amazon EventBridge. Partner event sources are created out-of-band by a registered SaaS partner; this resource is read-only.",
    "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
    "properties": {
        "Name": {
            "description": "The name of the partner event source.",
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^aws\\.partner(/[\\.\\-_A-Za-z0-9]+){2,}$"
        },
        "Arn": {
            "description": "The ARN of the partner event source.",
            "type": "string"
        },
        "CreatedBy": {
            "description": "The name of the SaaS partner that created the event source.",
            "type": "string"
        },
        "CreationTime": {
            "description": "The date and time that the event source was created.",
            "type": "string",
            "format": "date-time"
        },
        "ExpirationTime": {
            "description": "The date and time that the event source will expire if you do not create a matching event bus.",
            "type": "string",
            "format": "date-time"
        },
        "State": {
            "description": "The state of the event source.",
            "type": "string",
            "enum": [
                "PENDING",
                "ACTIVE",
                "DELETED"
            ]
        }
    },
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/Name"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/CreatedBy",
        "/properties/CreationTime",
        "/properties/ExpirationTime",
        "/properties/State"
    ],
    "primaryIdentifier": [
        "/properties/Arn"
    ],
    "additionalIdentifiers": [
        [
            "/properties/Name"
        ]
    ],
    "tagging": {
        "taggable": false,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false
    },
    "handlers": {
        "read": {
            "permissions": [
                "events:DescribeEventSource"
            ]
        },
        "list": {
            "permissions": [
                "events:ListEventSources"
            ]
        }
    }
}
