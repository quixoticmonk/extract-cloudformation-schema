{
    "typeName": "AWS::DeviceFarm::Device",
    "description": "Resource Type definition for AWS::DeviceFarm::Device. Represents a device type that an app is tested against in AWS Device Farm.",
    "properties": {
        "Arn": {
            "type": "string",
            "description": "The device's ARN.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "Name": {
            "type": "string",
            "description": "The device's display name.",
            "maxLength": 256
        },
        "Manufacturer": {
            "type": "string",
            "description": "The device's manufacturer name."
        },
        "Model": {
            "type": "string",
            "description": "The device's model name."
        },
        "ModelId": {
            "type": "string",
            "description": "The device's model ID."
        },
        "FormFactor": {
            "type": "string",
            "description": "The device's form factor.",
            "enum": [
                "PHONE",
                "TABLET"
            ]
        },
        "Platform": {
            "type": "string",
            "description": "The device's platform.",
            "enum": [
                "ANDROID",
                "IOS"
            ]
        },
        "Os": {
            "type": "string",
            "description": "The device's operating system type."
        },
        "Cpu": {
            "$ref": "#/definitions/CPU"
        },
        "Resolution": {
            "$ref": "#/definitions/Resolution"
        },
        "HeapSize": {
            "type": "integer",
            "description": "The device's heap size, expressed in bytes."
        },
        "Memory": {
            "type": "integer",
            "description": "The device's total memory size, expressed in bytes."
        },
        "Image": {
            "type": "string",
            "description": "The device's image name."
        },
        "RemoteAccessEnabled": {
            "type": "boolean",
            "description": "Specifies whether remote access has been enabled for the specified device."
        },
        "FleetType": {
            "type": "string",
            "description": "The type of fleet to which this device belongs. Possible values are PRIVATE and PUBLIC."
        },
        "FleetName": {
            "type": "string",
            "description": "The name of the fleet to which this device belongs."
        },
        "Tags": {
            "type": "array",
            "description": "The tags attached to the device.",
            "insertionOrder": false,
            "maxItems": 150,
            "items": {
                "type": "object",
                "properties": {
                    "Key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "Value": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 256
                    }
                },
                "required": [
                    "Key",
                    "Value"
                ],
                "additionalProperties": false
            }
        }
    },
    "definitions": {
        "CPU": {
            "type": "object",
            "description": "Represents the amount of CPU that an app is using on a physical device.",
            "properties": {
                "Frequency": {
                    "type": "string",
                    "description": "The CPU's frequency."
                },
                "Architecture": {
                    "type": "string",
                    "description": "The CPU's architecture (for example, x86 or ARM)."
                },
                "Clock": {
                    "type": "number",
                    "description": "The clock speed of the device's CPU."
                }
            },
            "additionalProperties": false
        },
        "Resolution": {
            "type": "object",
            "description": "Represents the screen resolution of a device in height and width, expressed in pixels.",
            "properties": {
                "Width": {
                    "type": "integer",
                    "description": "The screen resolution's width, expressed in pixels."
                },
                "Height": {
                    "type": "integer",
                    "description": "The screen resolution's height, expressed in pixels."
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/Name",
        "/properties/Manufacturer",
        "/properties/Model",
        "/properties/ModelId",
        "/properties/FormFactor",
        "/properties/Platform",
        "/properties/Os",
        "/properties/Cpu",
        "/properties/Resolution",
        "/properties/HeapSize",
        "/properties/Memory",
        "/properties/Image",
        "/properties/RemoteAccessEnabled",
        "/properties/FleetType",
        "/properties/FleetName"
    ],
    "primaryIdentifier": [
        "/properties/Arn"
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "devicefarm:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "devicefarm:GetDevice",
                "devicefarm:ListTagsForResource"
            ]
        },
        "list": {
            "permissions": [
                "devicefarm:ListDevices"
            ]
        }
    }
}
