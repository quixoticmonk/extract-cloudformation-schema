{
    "typeName": "AWS::EC2::ExportImageTask",
    "description": "Resource schema for an EC2 Export Image Task. This is a read-only resource representing an image export job.",
    "properties": {
        "Arn": {
            "type": "string",
            "description": "The ARN of the export image task."
        },
        "ExportImageTaskId": {
            "type": "string",
            "description": "The ID of the export image task."
        },
        "Description": {
            "type": "string",
            "description": "A description of the image being exported.",
            "maxLength": 255
        },
        "ImageId": {
            "type": "string",
            "description": "The ID of the image."
        },
        "S3ExportLocation": {
            "$ref": "#/definitions/S3ExportLocation"
        },
        "Status": {
            "type": "string",
            "description": "The status of the export image task."
        },
        "Progress": {
            "type": "string",
            "description": "The percent complete of the export image task."
        },
        "Tags": {
            "type": "array",
            "description": "The tags for the export image task.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "insertionOrder": false
        }
    },
    "definitions": {
        "S3ExportLocation": {
            "type": "object",
            "description": "Describes the destination for an export image task.",
            "properties": {
                "S3Bucket": {
                    "type": "string",
                    "description": "The destination Amazon S3 bucket."
                },
                "S3Prefix": {
                    "type": "string",
                    "description": "The prefix (logical hierarchy) in the bucket."
                }
            },
            "required": [
                "S3Bucket"
            ],
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "description": "A key-value pair to associate with a resource.",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key name of the tag.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The value for the tag.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": [
                "Key",
                "Value"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "ImageId",
        "S3ExportLocation"
    ],
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/Description",
        "/properties/ImageId",
        "/properties/S3ExportLocation",
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/ExportImageTaskId",
        "/properties/Status",
        "/properties/Progress"
    ],
    "primaryIdentifier": [
        "/properties/Arn"
    ],
    "additionalIdentifiers": [
        [
            "/properties/ExportImageTaskId"
        ]
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "ec2:DescribeTags"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "ec2:DescribeExportImageTasks",
                "ec2:DescribeTags"
            ]
        },
        "list": {
            "permissions": [
                "ec2:DescribeExportImageTasks"
            ]
        }
    }
}
