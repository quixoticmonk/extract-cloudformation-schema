{
    "typeName": "AWS::Chime::MediaConcatenationPipeline",
    "description": "A media concatenation pipeline in the Amazon Chime SDK that concatenates media artifacts from a media capture pipeline.",
    "definitions": {
        "ConcatenationSource": {
            "type": "object",
            "description": "The source type and media pipeline configuration settings in a configuration object.",
            "properties": {
                "Type": {
                    "type": "string",
                    "description": "The type of concatenation source in a configuration object.",
                    "enum": ["MediaCapturePipeline"]
                },
                "MediaCapturePipelineSourceConfiguration": {
                    "$ref": "#/definitions/MediaCapturePipelineSourceConfiguration"
                }
            },
            "required": ["Type", "MediaCapturePipelineSourceConfiguration"],
            "additionalProperties": false
        },
        "MediaCapturePipelineSourceConfiguration": {
            "type": "object",
            "description": "The source configuration object of a media capture pipeline.",
            "properties": {
                "MediaPipelineArn": {
                    "type": "string",
                    "description": "The media pipeline ARN in the configuration object of a media capture pipeline.",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
                },
                "ChimeSdkMeetingConfiguration": {
                    "$ref": "#/definitions/ChimeSdkMeetingConcatenationConfiguration"
                }
            },
            "required": ["MediaPipelineArn", "ChimeSdkMeetingConfiguration"],
            "additionalProperties": false
        },
        "ChimeSdkMeetingConcatenationConfiguration": {
            "type": "object",
            "description": "The configuration object of the Amazon Chime SDK meeting concatenation for a specified media pipeline.",
            "properties": {
                "ArtifactsConfiguration": {
                    "$ref": "#/definitions/ArtifactsConcatenationConfiguration"
                }
            },
            "required": ["ArtifactsConfiguration"],
            "additionalProperties": false
        },
        "ArtifactsConcatenationConfiguration": {
            "type": "object",
            "description": "The configuration for the artifacts concatenation.",
            "properties": {
                "Audio": {
                    "$ref": "#/definitions/AudioConcatenationConfiguration"
                },
                "Video": {
                    "$ref": "#/definitions/VideoConcatenationConfiguration"
                },
                "Content": {
                    "$ref": "#/definitions/ContentConcatenationConfiguration"
                },
                "DataChannel": {
                    "$ref": "#/definitions/DataChannelConcatenationConfiguration"
                },
                "TranscriptionMessages": {
                    "$ref": "#/definitions/TranscriptionMessagesConcatenationConfiguration"
                },
                "MeetingEvents": {
                    "$ref": "#/definitions/MeetingEventsConcatenationConfiguration"
                },
                "CompositedVideo": {
                    "$ref": "#/definitions/CompositedVideoConcatenationConfiguration"
                }
            },
            "required": ["Audio", "Video", "Content", "DataChannel", "TranscriptionMessages", "MeetingEvents", "CompositedVideo"],
            "additionalProperties": false
        },
        "AudioConcatenationConfiguration": {
            "type": "object",
            "description": "The audio artifact concatenation configuration object.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables the audio artifact concatenation configuration object.",
                    "enum": ["Enabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "VideoConcatenationConfiguration": {
            "type": "object",
            "description": "The configuration object of a video concatenation pipeline.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "ContentConcatenationConfiguration": {
            "type": "object",
            "description": "The composited content configuration object for a specified media pipeline.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "DataChannelConcatenationConfiguration": {
            "type": "object",
            "description": "The content configuration object's data channel.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "TranscriptionMessagesConcatenationConfiguration": {
            "type": "object",
            "description": "The configuration object for concatenating transcription messages.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "MeetingEventsConcatenationConfiguration": {
            "type": "object",
            "description": "The configuration object for an event concatenation pipeline.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "CompositedVideoConcatenationConfiguration": {
            "type": "object",
            "description": "The composited video configuration object for a specified media pipeline.",
            "properties": {
                "State": {
                    "type": "string",
                    "description": "Enables or disables the configuration object.",
                    "enum": ["Enabled", "Disabled"]
                }
            },
            "required": ["State"],
            "additionalProperties": false
        },
        "ConcatenationSink": {
            "type": "object",
            "description": "The data sink of the configuration object.",
            "properties": {
                "Type": {
                    "type": "string",
                    "description": "The type of data sink in the configuration object.",
                    "enum": ["S3Bucket"]
                },
                "S3BucketSinkConfiguration": {
                    "$ref": "#/definitions/S3BucketSinkConfiguration"
                }
            },
            "required": ["Type", "S3BucketSinkConfiguration"],
            "additionalProperties": false
        },
        "S3BucketSinkConfiguration": {
            "type": "object",
            "description": "The configuration settings for the S3 bucket.",
            "properties": {
                "Destination": {
                    "type": "string",
                    "description": "The destination URL of the S3 bucket.",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
                }
            },
            "required": ["Destination"],
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "description": "A key-value pair to associate with a resource.",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key of the tag.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The value of the tag.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        }
    },
    "properties": {
        "MediaPipelineArn": {
            "type": "string",
            "description": "The ARN of the media concatenation pipeline.",
            "minLength": 1,
            "maxLength": 1011,
            "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
        },
        "MediaPipelineId": {
            "type": "string",
            "description": "The ID of the media concatenation pipeline.",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}$"
        },
        "Sources": {
            "type": "array",
            "description": "An object that specifies the sources for the media concatenation pipeline.",
            "items": {
                "$ref": "#/definitions/ConcatenationSource"
            },
            "minItems": 1,
            "maxItems": 1
        },
        "Sinks": {
            "type": "array",
            "description": "An object that specifies the data sinks for the media concatenation pipeline.",
            "items": {
                "$ref": "#/definitions/ConcatenationSink"
            },
            "minItems": 1,
            "maxItems": 1
        },
        "Status": {
            "type": "string",
            "description": "The status of the media concatenation pipeline.",
            "enum": ["Initializing", "InProgress", "Failed", "Stopping", "Stopped", "Paused", "NotStarted"]
        },
        "CreatedTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "The time at which the concatenation pipeline was created."
        },
        "UpdatedTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "The time at which the concatenation pipeline was last updated."
        },
        "Tags": {
            "type": "array",
            "description": "The tags associated with the media concatenation pipeline.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "maxItems": 200
        }
    },
    "required": ["Sources", "Sinks"],
    "readOnlyProperties": [
        "/properties/MediaPipelineArn",
        "/properties/MediaPipelineId",
        "/properties/Status",
        "/properties/CreatedTimestamp",
        "/properties/UpdatedTimestamp"
    ],
    "createOnlyProperties": [
        "/properties/Sources",
        "/properties/Sinks",
        "/properties/Tags"
    ],
    "primaryIdentifier": ["/properties/MediaPipelineArn"],
    "additionalIdentifiers": [["/properties/MediaPipelineId"]],
    "additionalProperties": false,
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "chime:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "chime:GetMediaPipeline",
                "chime:ListTagsForResource"
            ]
        },
        "list": {
            "permissions": [
                "chime:ListMediaPipelines"
            ]
        }
    }
}
