{
    "typeName": "AWS::DeviceFarm::DeviceInstance",
    "description": "Resource Type definition for AWS::DeviceFarm::DeviceInstance. Represents a device instance associated with a private device fleet in AWS Device Farm. This is a read-only resource that provides information about a private device instance.",
    "definitions": {
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The tag key.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The tag value.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": [
                "Key",
                "Value"
            ],
            "additionalProperties": false
        },
        "InstanceProfile": {
            "type": "object",
            "description": "Represents the instance profile associated with the device instance.",
            "properties": {
                "Arn": {
                    "type": "string",
                    "description": "The Amazon Resource Name (ARN) of the instance profile.",
                    "minLength": 32,
                    "maxLength": 1011,
                    "pattern": "^arn:aws:devicefarm:.+$"
                },
                "Name": {
                    "type": "string",
                    "description": "The name of the instance profile.",
                    "maxLength": 256
                },
                "Description": {
                    "type": "string",
                    "description": "The description of the instance profile.",
                    "maxLength": 16384
                },
                "PackageCleanup": {
                    "type": "boolean",
                    "description": "When set to true, Device Farm removes app packages after a test run."
                },
                "ExcludeAppPackagesFromCleanup": {
                    "type": "array",
                    "description": "An array of app package names to exclude from cleanup.",
                    "insertionOrder": false,
                    "items": {
                        "type": "string"
                    }
                },
                "RebootAfterUse": {
                    "type": "boolean",
                    "description": "When set to true, Device Farm reboots the instance after a test run."
                }
            },
            "additionalProperties": false
        }
    },
    "properties": {
        "Arn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the device instance.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "DeviceArn": {
            "type": "string",
            "description": "The ARN of the device on which the device instance is running.",
            "minLength": 32,
            "maxLength": 1011,
            "pattern": "^arn:aws:devicefarm:.+$"
        },
        "Labels": {
            "type": "array",
            "description": "An array of strings that describe the device instance.",
            "insertionOrder": false,
            "items": {
                "type": "string"
            }
        },
        "Status": {
            "type": "string",
            "description": "The status of the device instance.",
            "enum": [
                "IN_USE",
                "PREPARING",
                "AVAILABLE",
                "NOT_AVAILABLE"
            ]
        },
        "Udid": {
            "type": "string",
            "description": "The unique device identifier (UDID) of the device instance."
        },
        "InstanceProfile": {
            "$ref": "#/definitions/InstanceProfile"
        },
        "Tags": {
            "type": "array",
            "description": "The tags assigned to the device instance.",
            "insertionOrder": false,
            "items": {
                "$ref": "#/definitions/Tag"
            }
        }
    },
    "additionalProperties": false,
    "createOnlyProperties": [
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/Arn",
        "/properties/DeviceArn",
        "/properties/Labels",
        "/properties/Status",
        "/properties/Udid",
        "/properties/InstanceProfile"
    ],
    "primaryIdentifier": [
        "/properties/Arn"
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "devicefarm:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "devicefarm:GetDeviceInstance",
                "devicefarm:ListTagsForResource"
            ]
        },
        "list": {
            "permissions": [
                "devicefarm:ListDeviceInstances"
            ]
        }
    }
}
