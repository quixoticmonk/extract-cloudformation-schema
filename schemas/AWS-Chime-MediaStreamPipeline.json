{
    "typeName": "AWS::Chime::MediaStreamPipeline",
    "description": "Resource Type definition for AWS::Chime::MediaStreamPipeline",
    "properties": {
        "MediaPipelineId": {
            "type": "string",
            "description": "The ID of the media stream pipeline.",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}$"
        },
        "MediaPipelineArn": {
            "type": "string",
            "description": "The ARN of the media stream pipeline.",
            "minLength": 1,
            "maxLength": 1011,
            "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
        },
        "Sources": {
            "type": "array",
            "description": "The media stream pipeline's data sources.",
            "items": {
                "$ref": "#/definitions/MediaStreamSource"
            },
            "minItems": 1,
            "insertionOrder": true
        },
        "Sinks": {
            "type": "array",
            "description": "The media stream pipeline's data sinks.",
            "items": {
                "$ref": "#/definitions/MediaStreamSink"
            },
            "minItems": 1,
            "maxItems": 2,
            "insertionOrder": true
        },
        "Status": {
            "type": "string",
            "description": "The status of the media stream pipeline.",
            "enum": ["Initializing", "InProgress", "Failed", "Stopping", "Stopped", "Paused", "NotStarted"]
        },
        "CreatedTimestamp": {
            "type": "string",
            "description": "The time at which the media stream pipeline was created, in ISO 8601 format.",
            "format": "date-time"
        },
        "UpdatedTimestamp": {
            "type": "string",
            "description": "The time at which the media stream pipeline was updated, in ISO 8601 format.",
            "format": "date-time"
        },
        "Tags": {
            "type": "array",
            "description": "The tag key-value pairs.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "maxItems": 200,
            "insertionOrder": false
        }
    },
    "definitions": {
        "MediaStreamSource": {
            "type": "object",
            "description": "Structure that contains the settings for media stream sources.",
            "properties": {
                "SourceType": {
                    "type": "string",
                    "description": "The type of media stream source.",
                    "enum": ["ChimeSdkMeeting"]
                },
                "SourceArn": {
                    "type": "string",
                    "description": "The ARN of the meeting.",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
                }
            },
            "required": ["SourceType", "SourceArn"],
            "additionalProperties": false
        },
        "MediaStreamSink": {
            "type": "object",
            "description": "Structure that contains the settings for a media stream sink.",
            "properties": {
                "SinkArn": {
                    "type": "string",
                    "description": "The ARN of the Kinesis Video Stream pool returned by the CreateMediaPipelineKinesisVideoStreamPool API.",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^arn[\\/\\:\\-\\_\\.a-zA-Z0-9]+$"
                },
                "SinkType": {
                    "type": "string",
                    "description": "The media stream sink's type.",
                    "enum": ["KinesisVideoStreamPool"]
                },
                "ReservedStreamCapacity": {
                    "type": "integer",
                    "description": "Specifies the number of streams that the sink can accept.",
                    "minimum": 1,
                    "maximum": 10
                },
                "MediaStreamType": {
                    "type": "string",
                    "description": "The media stream sink's media stream type.",
                    "enum": ["MixedAudio", "IndividualAudio"]
                }
            },
            "required": ["SinkArn", "SinkType", "ReservedStreamCapacity", "MediaStreamType"],
            "additionalProperties": false
        },
        "Tag": {
            "type": "object",
            "description": "A key-value pair to associate with the resource.",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The key name of the tag.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The value for the tag.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        }
    },
    "required": ["Sources", "Sinks"],
    "readOnlyProperties": [
        "/properties/MediaPipelineId",
        "/properties/MediaPipelineArn",
        "/properties/Status",
        "/properties/CreatedTimestamp",
        "/properties/UpdatedTimestamp"
    ],
    "createOnlyProperties": [
        "/properties/Sources",
        "/properties/Sinks",
        "/properties/Tags"
    ],
    "primaryIdentifier": ["/properties/MediaPipelineArn"],
    "additionalIdentifiers": [["/properties/MediaPipelineId"]],
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "chime:ListTagsForResource"
        ]
    },
    "handlers": {
        "read": {
            "permissions": [
                "chime:GetMediaPipeline",
                "chime:ListTagsForResource"
            ]
        },
        "list": {
            "permissions": [
                "chime:ListMediaPipelines"
            ]
        }
    },
    "additionalProperties": false
}
