{
    "typeName": "AWS::EMRServerless::JobRun",
    "description": "Represents an Amazon EMR Serverless job run. A job run is a unit of work, such as a Spark JAR, Hive query, or SparkSQL query, that you submit to an Amazon EMR Serverless application.",
    "definitions": {
        "Tag": {
            "type": "object",
            "properties": {
                "Key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9 /_.:=+@-]+$"
                },
                "Value": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9 /_.:=+@-]*$"
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        },
        "JobDriver": {
            "type": "object",
            "description": "The driver that the job runs on. This is a union: exactly one member must be specified.",
            "properties": {
                "SparkSubmit": {
                    "$ref": "#/definitions/SparkSubmit"
                },
                "Hive": {
                    "$ref": "#/definitions/Hive"
                }
            },
            "oneOf": [
                {"required": ["SparkSubmit"]},
                {"required": ["Hive"]}
            ],
            "additionalProperties": false
        },
        "SparkSubmit": {
            "type": "object",
            "description": "The configurations for the Spark submit driver.",
            "properties": {
                "EntryPoint": {
                    "type": "string",
                    "description": "The entry point for the Spark submit job run.",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": ".*\\S.*"
                },
                "EntryPointArguments": {
                    "type": "array",
                    "description": "The arguments for the Spark submit job run.",
                    "items": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 10280
                    }
                },
                "SparkSubmitParameters": {
                    "type": "string",
                    "description": "The parameters for the Spark submit job run.",
                    "minLength": 1,
                    "maxLength": 102400,
                    "pattern": ".*\\S.*"
                }
            },
            "required": ["EntryPoint"],
            "additionalProperties": false
        },
        "Hive": {
            "type": "object",
            "description": "The configurations for the Hive job driver.",
            "properties": {
                "Query": {
                    "type": "string",
                    "description": "The query for the Hive job run.",
                    "minLength": 1,
                    "maxLength": 10280,
                    "pattern": ".*\\S.*"
                },
                "InitQueryFile": {
                    "type": "string",
                    "description": "The query file for the Hive job run.",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": ".*\\S.*"
                },
                "Parameters": {
                    "type": "string",
                    "description": "The parameters for the Hive job run.",
                    "minLength": 1,
                    "maxLength": 102400,
                    "pattern": ".*\\S.*"
                }
            },
            "required": ["Query"],
            "additionalProperties": false
        },
        "ConfigurationOverrides": {
            "type": "object",
            "description": "The configuration overrides for the job run.",
            "properties": {
                "ApplicationConfiguration": {
                    "type": "array",
                    "description": "The override configurations for the application.",
                    "items": {
                        "$ref": "#/definitions/Configuration"
                    },
                    "maxItems": 100
                },
                "MonitoringConfiguration": {
                    "$ref": "#/definitions/MonitoringConfiguration"
                }
            },
            "additionalProperties": false
        },
        "Configuration": {
            "type": "object",
            "description": "A configuration specification to be used when provisioning a job run.",
            "properties": {
                "Classification": {
                    "type": "string",
                    "description": "The classification within a configuration.",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": ".*\\S.*"
                },
                "Properties": {
                    "type": "object",
                    "description": "A set of properties specified within a configuration classification.",
                    "patternProperties": {
                        "^.*\\S.*$": {
                            "type": "string",
                            "minLength": 0,
                            "maxLength": 1024,
                            "pattern": "^.*\\S.*$"
                        }
                    },
                    "maxProperties": 100,
                    "additionalProperties": false
                },
                "Configurations": {
                    "type": "array",
                    "description": "A list of additional configurations to apply within a configuration object.",
                    "items": {
                        "$ref": "#/definitions/Configuration"
                    },
                    "maxItems": 100
                }
            },
            "required": ["Classification"],
            "additionalProperties": false
        },
        "MonitoringConfiguration": {
            "type": "object",
            "description": "The configuration setting for monitoring.",
            "properties": {
                "S3MonitoringConfiguration": {
                    "$ref": "#/definitions/S3MonitoringConfiguration"
                },
                "ManagedPersistenceMonitoringConfiguration": {
                    "$ref": "#/definitions/ManagedPersistenceMonitoringConfiguration"
                }
            },
            "additionalProperties": false
        },
        "S3MonitoringConfiguration": {
            "type": "object",
            "description": "The Amazon S3 configuration for monitoring log publishing.",
            "properties": {
                "LogUri": {
                    "type": "string",
                    "description": "The Amazon S3 destination URI for log publishing.",
                    "minLength": 1,
                    "maxLength": 10280,
                    "pattern": "[\\u0020-\\uD7FF\\uE000-\\uFFFD\\uD800\\uDBFF-\\uDC00\\uDFFF\\r\\n\\t]*"
                }
            },
            "additionalProperties": false
        },
        "ManagedPersistenceMonitoringConfiguration": {
            "type": "object",
            "description": "The managed log persistence configuration for a job run.",
            "properties": {
                "Enabled": {
                    "type": "boolean",
                    "description": "Enables managed logging and defaults to true. If set to false, managed logging is turned off."
                }
            },
            "additionalProperties": false
        }
    },
    "properties": {
        "ApplicationId": {
            "type": "string",
            "description": "The ID of the application on which the job run is submitted.",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-z]+$"
        },
        "JobRunId": {
            "type": "string",
            "description": "The ID of the job run.",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-z]+$"
        },
        "Arn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the job run.",
            "minLength": 60,
            "maxLength": 1024,
            "pattern": "^arn:(aws[a-zA-Z0-9-]*):emr-serverless:.+:(\\d{12}):\\/applications\\/[0-9a-zA-Z]+\\/jobruns\\/[0-9a-zA-Z]+$"
        },
        "Name": {
            "type": "string",
            "description": "The optional job run name.",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
        },
        "ExecutionRoleArn": {
            "type": "string",
            "description": "The execution role ARN of the job run.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:(aws[a-zA-Z0-9-]*):iam::([0-9]{12}):(role((\\u002F)|(\\u002F[\\u0021-\\u007F]+\\u002F))[\\w+=,.@-]+)$"
        },
        "ReleaseLabel": {
            "type": "string",
            "description": "The Amazon EMR release associated with the application on which the job is running.",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "Mode": {
            "type": "string",
            "description": "The mode of the job run.",
            "enum": ["BATCH", "STREAMING"]
        },
        "State": {
            "type": "string",
            "description": "The state of the job run.",
            "enum": [
                "SUBMITTED",
                "PENDING",
                "SCHEDULED",
                "RUNNING",
                "SUCCESS",
                "FAILED",
                "CANCELLING",
                "CANCELLED",
                "QUEUED"
            ]
        },
        "StateDetails": {
            "type": "string",
            "description": "The state details of the job run.",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
        },
        "ExecutionTimeoutMinutes": {
            "type": "integer",
            "description": "The maximum duration, in minutes, for the job run. If the job run exceeds this duration, it is cancelled automatically.",
            "minimum": 0,
            "maximum": 1000000
        },
        "JobDriver": {
            "$ref": "#/definitions/JobDriver"
        },
        "ConfigurationOverrides": {
            "$ref": "#/definitions/ConfigurationOverrides"
        },
        "Tags": {
            "type": "array",
            "description": "The tags assigned to the job run.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "maxItems": 200
        },
        "CreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the job run was created."
        },
        "CreatedBy": {
            "type": "string",
            "description": "The user who created the job run.",
            "minLength": 20,
            "maxLength": 2048,
            "pattern": "^arn:(aws[a-zA-Z0-9-]*):(iam|sts)::(\\d{12})?:[\\w/+=,.@-]+$"
        },
        "UpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the job run was last updated."
        }
    },
    "createOnlyProperties": [
        "/properties/ApplicationId",
        "/properties/Name",
        "/properties/ExecutionRoleArn",
        "/properties/Mode",
        "/properties/ExecutionTimeoutMinutes",
        "/properties/JobDriver",
        "/properties/ConfigurationOverrides",
        "/properties/Tags"
    ],
    "readOnlyProperties": [
        "/properties/JobRunId",
        "/properties/Arn",
        "/properties/ReleaseLabel",
        "/properties/State",
        "/properties/StateDetails",
        "/properties/CreatedAt",
        "/properties/CreatedBy",
        "/properties/UpdatedAt"
    ],
    "primaryIdentifier": ["/properties/Arn"],
    "additionalIdentifiers": [
        ["/properties/ApplicationId", "/properties/JobRunId"]
    ],
    "additionalProperties": false,
    "tagging": {
        "taggable": true,
        "tagOnCreate": false,
        "tagUpdatable": false,
        "cloudFormationSystemTags": false,
        "tagProperty": "/properties/Tags",
        "permissions": ["emr-serverless:ListTagsForResource"]
    },
    "handlers": {
        "read": {
            "permissions": [
                "emr-serverless:GetJobRun"
            ]
        },
        "list": {
            "handlerSchema": {
                "properties": {
                    "ApplicationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[0-9a-z]+$"
                    }
                },
                "required": ["ApplicationId"]
            },
            "permissions": [
                "emr-serverless:ListJobRuns"
            ]
        }
    }
}
